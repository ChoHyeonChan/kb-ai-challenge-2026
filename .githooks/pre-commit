#!/bin/sh
# 커밋 직전 비밀정보·개인정보 유출 차단.
# 설치: git config core.hooksPath .githooks
#
# 원칙 1. 감지된 비밀값을 **절대 출력하지 않는다.** 파일명과 개수만 알린다.
#         로그·터미널에 키가 남으면 차단의 의미가 없다.
# 원칙 2. **한글 파일명을 놓치지 않는다.**
#         git 은 기본(core.quotepath=true)으로 비ASCII 경로를 \354\240\234 처럼
#         8진수로 이스케이프해 출력한다. 그대로 grep 하면 '신청서' 가 걸리지 않는다.
#         실제로 이 훅이 한글 파일명을 통과시킨 사고가 있었다 → 아래 -c 옵션 필수.

fail=0
GIT="git -c core.quotepath=false"
staged=$($GIT diff --cached --name-only)

# 1) .env 계열 (.env.example 은 키 없는 템플릿이므로 허용)
leaked=$(echo "$staged" | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$')
if [ -n "$leaked" ]; then
  echo "커밋 차단: 다음 파일은 커밋할 수 없습니다."
  echo "$leaked" | sed 's/^/   - /'
  fail=1
fi

# 2) 내용에 키 형태 문자열 — 값은 출력하지 않고 위치만 알린다
hits=$($GIT diff --cached -U0 \
  | grep -nE '(sk-[A-Za-z0-9_-]{20,}|api[_-]?key["'"'"' ]*[:=]["'"'"' ]*[A-Za-z0-9_-]{20,})' \
  | wc -l)
if [ "$hits" -gt 0 ]; then
  echo "커밋 차단: API 키로 보이는 문자열이 ${hits}곳에서 감지되었습니다."
  echo "   (값은 안전을 위해 표시하지 않습니다. 아래 파일을 확인하세요)"
  echo "$staged" | sed 's/^/   - /'
  fail=1
fi

# 3) 제출 서류 — 성명·생년월일·전화·이메일·주소·서명이 들어간다.
#    private 저장소여도 넣지 않는다. 배포·zip 동봉·팀원 공유로 퍼질 경로가 많고,
#    한 번 커밋되면 히스토리에서 지워지지 않는다. 서류는 저장소 밖에서 관리한다.
docs_leak=$(echo "$staged" | grep -iE '신청서|서약서|동의서|개인정보|application_form|consent')
if [ -n "$docs_leak" ]; then
  echo "커밋 차단: 제출 서류로 보이는 파일이 포함되었습니다."
  echo "   (성명·생년월일·연락처·주소·서명이 들어가는 문서는 저장소에 넣지 않습니다)"
  echo "$docs_leak" | sed 's/^/   - /'
  echo "   → 서류는 저장소 밖 폴더에 두고, 제출 zip 을 만들 때만 합칩니다."
  fail=1
fi

if [ "$fail" -eq 1 ]; then
  echo ""
  echo "   한 번이라도 커밋되면 파일을 지워도 히스토리에 남습니다."
  echo "   키는 폐기·재발급이라도 가능하지만, 개인정보는 되돌릴 방법이 없습니다."
fi
exit $fail
